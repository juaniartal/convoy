# Copy this file to .env (never commit the real .env — it's gitignored).
# You normally don't fill these in by hand: the first time you run
# `npm run dev`, Probot's manifest flow creates the GitHub App for you and
# writes APP_ID / PRIVATE_KEY_PATH / WEBHOOK_SECRET below automatically.
# Only fill them in yourself if you hit the manual-setup path described in
# the README's troubleshooting section.
APP_ID=
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=

# Local dev only: forwards GitHub's webhook deliveries to your machine.
# Not used in production — there, GitHub delivers directly to your ingress URL.
WEBHOOK_PROXY_URL=

# Port the server listens on.
PORT=3000

# Optional: gates the dashboard behind a login page with this as the shared
# access key (scripts/reverse proxies can also send
# "Authorization: Bearer <value>" directly). Leave unset only if your
# ingress already restricts who can reach this service some other way.
CONVOY_API_KEY=

# Optional: adds a "Log in with <provider>" button to the login page backed
# by any standard OIDC provider (Azure AD, Google, Okta, ...). All four
# must be set together or none are used. CONVOY_OIDC_REDIRECT_URI must be
# the exact URL registered with the provider, ending in
# /api/auth/oidc/callback.
CONVOY_OIDC_ISSUER_URL=
CONVOY_OIDC_CLIENT_ID=
CONVOY_OIDC_CLIENT_SECRET=
CONVOY_OIDC_REDIRECT_URI=
# Button label shown on the login page. Defaults to "Log in with SSO".
CONVOY_OIDC_BUTTON_LABEL=
# Dev/test only: lets CONVOY_OIDC_ISSUER_URL point at a plain-HTTP IdP
# (e.g. a local fake one while testing). Every real provider is HTTPS --
# never set this against an actual deployment.
CONVOY_OIDC_ALLOW_INSECURE=

# Path to the per-repo classification overrides / exclude list.
CONVOY_CONFIG_PATH=./convoy.yaml
