{
  "name": "convoy",
  "version": "0.1.0",
  "description": "Self-hosted, real-time GitHub Actions pipeline visualizer for an entire organization.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/start.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node lib/start.js",
    "start": "node lib/start.js",
    "demo": "npm run build && node lib/demo.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "probot": "^14.3.2",
    "yaml": "^2.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nock": "^14.0.17",
    "prettier": "^3.3.2",
    "smee-client": "^5.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
